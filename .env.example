# OpenAPI JSON used to build MCP tools. Defaults to ./openapi.json.
OPENAPI_PATH=openapi.json

# Target API base URL used by httpx.AsyncClient.
API_BASE_URL=http://127.0.0.1:8080/api/

# FastMCP server display name.
FASTMCP_SERVER_NAME=Dataverse FastMCP

# API key behavior:
# - env: read DATAVERSE_API_TOKEN from this process and send it to Dataverse.
# - request-header: read X-Dataverse-key from each incoming HTTP MCP request.
# - none: do not add a Dataverse API key.
API_KEY_MODE=request-header
API_KEY_HEADER=X-Dataverse-key
API_KEY_ENV=DATAVERSE_API_TOKEN

# Optional comma-separated OpenAPI tag filters. Choose one profile by
# uncommenting its INCLUDE_TAGS/EXCLUDE_TAGS lines.
#
# Current generated tag groups:
# Access, Admin, Users, Datasets, Dataset Fields, Dataverse Featured Items,
# Dataverses, Files, External Tools, Info, Licenses, Metadata, Notifications,
# Roles, Search, Workflows
#
# Profile: Data steward
# For creating, editing, searching, publishing, and organizing datasets/files.
# INCLUDE_TAGS=Datasets,Dataverses,Files,Search,Licenses,Dataset Fields,Metadata
# EXCLUDE_TAGS=Admin,Users,Roles,Notifications,Workflows,External Tools,Dataverse Featured Items
#
# Profile: Read-only discovery
# For unauthenticated browsing/search/download/info use. Pair with
# API_KEY_MODE=none if the selected endpoints do not require auth.
# INCLUDE_TAGS=Info,Search,Access,Datasets,Dataverses,Files,Licenses,Metadata
# EXCLUDE_TAGS=Admin,Users,Roles,Notifications,Dataset Fields,Workflows,External Tools,Dataverse Featured Items
#
# Profile: Repository admin
# For administrative operations plus user, role, notification, workflow, and
# integration management.
# INCLUDE_TAGS=Admin,Users,Roles,Notifications,Info,Workflows,External Tools,Dataverse Featured Items,Metadata
#
# Profile: Data access
# For file and dataset download/access workflows.
# INCLUDE_TAGS=Access,Files,Datasets,Licenses
# EXCLUDE_TAGS=Admin,Users,Roles,Notifications,Workflows,External Tools,Dataverse Featured Items
#
# Profile: Metadata curator
# For dataset metadata, metadata blocks, field definitions, licenses, and
# controlled vocabularies.
# INCLUDE_TAGS=Datasets,Dataverses,Dataset Fields,Metadata,Licenses,Info
# EXCLUDE_TAGS=Admin,Users,Roles,Notifications,Access,Workflows,External Tools,Dataverse Featured Items
#
# Profile: Collection manager
# For dataverse collection setup, featured items, dataset organization, and
# collection-facing metadata.
# INCLUDE_TAGS=Dataverses,Dataverse Featured Items,Datasets,Files,Licenses,Metadata
# EXCLUDE_TAGS=Admin,Users,Roles,Notifications,Workflows,External Tools
#
# Profile: Full API except administrative groups
# For broad use while hiding administration, identity, notification, workflow,
# integration, and featured-item management operations.
# EXCLUDE_TAGS=Admin,Users,Roles,Notifications,Workflows,External Tools,Dataverse Featured Items

# Optional Dataverse API token. Used only when API_KEY_MODE=env.
# Sent as: X-Dataverse-key: <token>
DATAVERSE_API_TOKEN=

# Optional bearer token. Sent as: Authorization: Bearer <token>
API_BEARER_TOKEN=

# Optional extra headers as JSON, for example:
# API_HEADERS_JSON={"X-Example":"value"}
API_HEADERS_JSON=

# HTTP request timeout in seconds.
API_TIMEOUT=30

# Optional FastMCP runtime defaults. request-header mode requires an HTTP transport.
FASTMCP_TRANSPORT=streamable-http
FASTMCP_HOST=127.0.0.1
FASTMCP_PORT=8000
FASTMCP_PATH=/mcp
# Optional. Must be DEBUG, INFO, WARNING, ERROR, or CRITICAL when set.
# FASTMCP_LOG_LEVEL=INFO
