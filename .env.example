# OpenAPI JSON used to build MCP tools. Defaults to ./openapi.json.
OPENAPI_PATH=openapi.json

# Target API base URL used by httpx.AsyncClient.
API_BASE_URL=http://127.0.0.1:8080/api/

# FastMCP server display name.
FASTMCP_SERVER_NAME=Dataverse FastMCP

# API key behavior:
# - env: read DATAVERSE_API_TOKEN from this process and send it to Dataverse.
# - request-header: read X-Dataverse-key from each incoming HTTP MCP request.
# - none: do not add a Dataverse API key.
API_KEY_MODE=request-header
API_KEY_HEADER=X-Dataverse-key
API_KEY_ENV=DATAVERSE_API_TOKEN

# Optional comma-separated OpenAPI tag filters. Choose one profile by
# uncommenting its INCLUDE_TAGS/EXCLUDE_TAGS lines.
#
# Profile: Data steward
# For creating, editing, searching, publishing, and organizing datasets/files.
# INCLUDE_TAGS=Datasets,Dataverses,Files,Search,Licenses,Dataset Fields
# EXCLUDE_TAGS=Admin,Users,Roles,Notifications
#
# Profile: Read-only discovery
# For unauthenticated browsing/search/download/info use. Pair with
# API_KEY_MODE=none if the selected endpoints do not require auth.
# INCLUDE_TAGS=Info,Search,Access,Datasets,Dataverses,Files,Licenses
# EXCLUDE_TAGS=Admin,Users,Roles,Notifications,Dataset Fields
#
# Profile: Repository admin
# For administrative operations plus user, role, and notification management.
# INCLUDE_TAGS=Admin,Users,Roles,Notifications,Info
#
# Profile: Data access
# For file and dataset download/access workflows.
# INCLUDE_TAGS=Access,Files,Datasets
# EXCLUDE_TAGS=Admin,Users,Roles,Notifications
#
# Profile: Metadata curator
# For dataset metadata, metadata blocks, field definitions, licenses, and
# controlled vocabularies.
# INCLUDE_TAGS=Datasets,Dataset Fields,Licenses,Info
# EXCLUDE_TAGS=Admin,Users,Roles,Notifications,Access
#
# Profile: Full API except admin
# For broad use while hiding administrative operations.
# EXCLUDE_TAGS=Admin

# Optional Dataverse API token. Used only when API_KEY_MODE=env.
# Sent as: X-Dataverse-key: <token>
DATAVERSE_API_TOKEN=

# Optional bearer token. Sent as: Authorization: Bearer <token>
API_BEARER_TOKEN=

# Optional extra headers as JSON, for example:
# API_HEADERS_JSON={"X-Example":"value"}
API_HEADERS_JSON=

# HTTP request timeout in seconds.
API_TIMEOUT=30

# Optional FastMCP runtime defaults. request-header mode requires an HTTP transport.
FASTMCP_TRANSPORT=streamable-http
FASTMCP_HOST=127.0.0.1
FASTMCP_PORT=8000
FASTMCP_PATH=/mcp
# Optional. Must be DEBUG, INFO, WARNING, ERROR, or CRITICAL when set.
# FASTMCP_LOG_LEVEL=INFO
